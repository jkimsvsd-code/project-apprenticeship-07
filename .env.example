# Local development: npm run setup:local creates an ignored .dev.vars.
# Cloudflare bindings are read server-side, not NEXT_PUBLIC_* variables.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:5173
# Production: set a distinct random secret (32+ chars) and the fixed HTTPS URL
# through the Sites runtime environment tools. Never commit live values.
